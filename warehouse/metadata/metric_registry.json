   "label": "specific oil consumption",
   "unit": "ml/kWh",
   "precision": 3,
   "kind": "ratio",
   "synonyms": [
    "specific oil consumption",
    "specific oil",
    "sfoc"
   ],
   "applies_to": [
    "THERMAL"
   ],
   "expr": {
    "all": {
     "num": "SUM(COALESCE(hfo_consumed_kl, 0) + COALESCE(ldo_consumed_kl, 0))",
     "den": "SUM(gross_gen_mu)",
     "scale": 1
    }
   }
  },
  {
   "key": "weighted_gcv_coal",
   "label": "weighted average coal GCV",
   "unit": "kcal/kg",
   "precision": 0,
   "kind": "ratio",
   "synonyms": [
    "gcv",
    "coal gcv",
    "calorific value",
    "gross calorific value"
   ],
   "applies_to": [
    "THERMAL"
   ],
   "expr": {
    "daily": {
     "num": "SUM(gcv_coal_kcal_kg * coal_consumed_mt)",
     "den": "SUM(CASE WHEN gcv_coal_kcal_kg IS NOT NULL THEN coal_consumed_mt END)",
     "scale": 1
    },
    "rollup": {
     "num": "SUM(gcv_coal_x_coal_mt)",
     "den": "SUM(coal_mt_with_gcv)",
     "scale": 1
    }
   }
  },
