# Copy to .env and fill in. Same variable names as the WB POC, so its gateway values work here unchanged.
# Internal OpenAI-compatible vLLM gateway (reachable only over the VPN). Leave empty to run without the model:
# verified reports, single-metric lookups, glossary and capability answers still work.
SQL_VERIFY_MODEL=
SQL_VERIFY_BASE_URL=
SQL_VERIFY_API_KEY=
# Optional: CA bundle for the gateway's TLS certificate (TLS is not verified when empty, as in the WB POC).
AI_MODEL_CA_BUNDLE_PATH=

# KPCL_DB_PATH=            # default: ../warehouse/kpcl_gms.db
KPCL_QUERY_TIMEOUT_SECONDS=30
KPCL_MAX_ROWS=200
KPCL_PROMPT_TOKEN_BUDGET=20000
# Show SQL, routes, timings and error details in the UI / API (admins only).
KPCL_SHOW_TECHNICAL_DETAILS=false
